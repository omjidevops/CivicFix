# ============================================================================
# CIVICFIX — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or set environment variables in production cloud provider
# ============================================================================

# Server Configuration
SERVER_PORT=8081

# Database Configuration (MySQL 8.0+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/civicfix?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Stateless Authentication (HMAC-SHA256 256-bit Hex Key)
JWT_SECRET=your_256_bit_hex_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-civicfix-app.vercel.app

# File Storage Configuration
APP_UPLOAD_DIR=uploads
